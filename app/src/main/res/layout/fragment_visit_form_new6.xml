<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/root_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="24dp">

        <!-- Top bar with red circle behind close -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical">

            <FrameLayout
                android:id="@+id/btn_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">

                <!-- Smaller red circle: 28dp -->
                <View
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/red_circle_bg" />

                <!-- X icon slightly bigger inside smaller circle -->
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_close"
                    android:tint="#FFFFFF"
                    android:contentDescription="Close"
                    tools:ignore="UseAppTint" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:text="Interaction Log"
                android:textSize="20sp"
                android:textStyle="bold"
                app:fontFamily="Poppins"
                android:textColor="#071F1E" />
        </RelativeLayout>

        <!-- Big subtitle -->
        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Log Your Interaction"
            android:textSize="30sp"
            android:textStyle="bold"
            app:fontFamily="Poppins"
            android:textColor="#071F1E"
            android:gravity="center" />

        <!-- Progress indicators -->
        <LinearLayout
            android:id="@+id/progress_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="12dp"
                android:src="@drawable/progress_dot_filled"
                android:contentDescription="Progress step 1"/>
            <ImageView
                android:layout_width="34dp"
                android:layout_height="12dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/progress_dot_filled"
                android:contentDescription="Progress step 2"/>
            <ImageView
                android:layout_width="34dp"
                android:layout_height="12dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/progress_dot_filled"
                android:contentDescription="Progress step 3"/>
            <ImageView
                android:layout_width="34dp"
                android:layout_height="12dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/progress_dot_filled"
                android:contentDescription="Progress step 4"/>
            <ImageView
                android:layout_width="36dp"
                android:layout_height="12dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/progress_dot_outline"
                android:contentDescription="Progress step 5"/>
            <ImageView
                android:layout_width="34dp"
                android:layout_height="12dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/progress_dot_dark"
                android:contentDescription="Progress step 6"/>
            <ImageView
                android:layout_width="34dp"
                android:layout_height="12dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/progress_dot_dark"
                android:contentDescription="Progress step 7"/>
        </LinearLayout>

        <!-- Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            app:cardUseCompatPadding="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Header row: question count and Skip -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tv_question"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Question 6/7"
                        android:textSize="16sp"
                        android:textColor="#424242" />

                    <TextView
                        android:id="@+id/btn_skip"
                        android:layout_width="78dp"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/button_skip_outline"
                        android:text="Skip"
                        android:textColor="#0D3B3B"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textAllCaps="false" />
                </RelativeLayout>

                <!-- thin divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#E6E6E6" />

                <!-- Big question title -->
                <TextView
                    android:id="@+id/tv_big_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Number of care\npackages given out"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:fontFamily="Poppins"
                    android:textColor="@color/black"
                    android:gravity="center" />

                <!-- counter row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="14dp">

                    <!-- Minus button (smaller) -->
                    <FrameLayout
                        android:id="@+id/btn_decrease"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="20dp">

                        <View
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/circle_button_bg"/>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_minus"
                            android:tint="#F4D03F"
                            android:contentDescription="Decrease count"
                            tools:ignore="UseAppTint" />
                    </FrameLayout>

                    <!-- Counter value -->
                    <TextView
                        android:id="@+id/tv_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        app:fontFamily="Poppins"
                        android:textColor="#071F1E"
                        android:gravity="center" />

                    <!-- Plus button (smaller) -->
                    <FrameLayout
                        android:id="@+id/btn_increase"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="20dp">

                        <View
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/circle_button_bg"/>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_plus"
                            android:tint="#F4D03F"
                            android:contentDescription="Increase count"
                            tools:ignore="UseAppTint" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Sub question -->
                <TextView
                    android:id="@+id/tv_sub_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="What items were included\nin the care package?"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:fontFamily="Poppins"
                    android:textColor="@color/black"
                    android:gravity="center" />

                <!-- Notes input (multiline) -->
                <EditText
                    android:id="@+id/et_notes"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/textfield_bg"
                    android:gravity="top|start"
                    android:hint="Enter notes here."
                    android:padding="12dp"
                    android:textColor="#071F1E"
                    android:textSize="14sp"
                    android:inputType="textMultiLine"
                    android:lines="5"
                    android:maxLines="6" />

                <!-- Buttons row -->
                <LinearLayout
                    android:id="@+id/nav_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="22dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/btn_previous"
                        android:layout_width="120dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="Previous"
                        android:textColor="#0D3B3B"
                        android:background="@drawable/button_outline"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btn_next"
                        android:layout_width="120dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="Next"
                        android:textColor="#F4D03F"
                        android:background="@drawable/button_next_filled"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- spacing bottom so scroll content looks centered on tall screens -->
        <View
            android:layout_width="match_parent"
            android:layout_height="18dp"/>
    </LinearLayout>
</ScrollView>
