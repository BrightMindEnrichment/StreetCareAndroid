<?xml version="1.0" encoding="utf-8"?><!--    Root LinearLayout-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="?attr/actionBarSize"
    android:orientation="vertical">

    <!--    Big centered screen title-->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:gravity="center"
        android:padding="2dp"
        android:text="@string/visit_log_inside"
        android:textColor="@color/black"
        android:textFontWeight="700"
        android:textSize="30sp"
        app:fontFamily="@font/poppins_bold"
        android:textStyle="bold" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_visitlog2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="35dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true"
        app:strokeColor="@color/gray700"
        app:strokeWidth="1.2dp">

        <!-- Inner vertical layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="38dp"
            android:paddingBottom="38dp">

            <!-- Checkbox + consent text in one row -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/consent_text"
                    android:textAlignment="center"
                    android:paddingStart="8dp"
                    app:layout_constraintTop_toTopOf="@id/cbConsent"
                    app:layout_constraintStart_toEndOf="@id/cbConsent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="@id/cbConsent"
                    app:layout_constraintVertical_bias="0.0"
                    android:textColor="@android:color/black"
                    android:textSize="16sp" />
                <CheckBox
                    android:id="@+id/cbConsent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="-11dp"
                    android:button="@drawable/checkbox_selector"
                    android:background="@null"
                    android:buttonTint="@null"
                    app:useMaterialThemeColors="false"/>

            </FrameLayout>


            <!-- Submit button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitConsent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:backgroundTint="#073532"
                android:elevation="4dp"
                android:enabled="false"
                android:text="@string/submit"
                android:textAllCaps="true"
                android:textColor="@color/golden_yellow"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="40dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>

