<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent">

    <!-- Top placeholder/status bar -->
    <View
        android:id="@+id/status_bar_placeholder"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- App bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"  android:layout_height="55dp"
        android:background="@android:color/white"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"  app:layout_constraintEnd_toEndOf="parent"      tools:layout_editor_absoluteX="0dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:padding="5dp"
        android:text="@string/visit_log_inside"
        android:textColor="@color/black"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textFontWeight="700"
        app:fontFamily="Poppins" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:orientation="horizontal">

        <View
            android:layout_width="40dp"
            android:layout_height="15dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/progress_dot_yellow_with_border" />

        <View
            android:layout_width="40dp"
            android:layout_height="15dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/progress_dot_green_dark" />

        <View
            android:layout_width="40dp"
            android:layout_height="15dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/progress_dot_green_dark" />

        <View
            android:layout_width="40dp"
            android:layout_height="15dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/progress_dot_green_dark" />

        <View
            android:layout_width="40dp"
            android:layout_height="15dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/progress_dot_green_dark" />

        <View
            android:layout_width="40dp"
            android:layout_height="15dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/progress_dot_green_dark" />

        <View
            android:layout_width="40dp"
            android:layout_height="15dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/progress_dot_green_dark" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_visitlog2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="30dp"
        android:paddingBottom="@dimen/padding_16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true"
        app:strokeColor="@color/gray700"
        app:strokeWidth="1.2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_8dp"
            app:strokeColor="@color/gray300"
            android:orientation="vertical">


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="12dp"
                    android:layout_gravity="start"
                    android:textFontWeight="400"
                    android:textColor="@color/black"
                    android:text="@string/additional_1_7"
                    android:textSize="16sp"/>


            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="19dp"
                android:layout_marginEnd="19dp"
                android:background="@color/gray300"/>
            <TextView
                android:layout_width="278dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/margin_8dp"
                android:layout_marginTop="10dp"
                android:padding="10dp"
                android:gravity="center"
                android:text="When was your\nInteraction?"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size24"
                android:textStyle="bold"
                app:fontFamily="Poppins"/>

            <LinearLayout
                android:layout_width="310dp"
                android:layout_height="23dp"
                android:layout_gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/start_time"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size16"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="310dp"
                android:layout_height="43dp"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:layout_marginTop="5dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/date_picker_card"
                    android:layout_width="0dp"
                    android:layout_height="43dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="11dp"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="@color/gray700"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/baseline_calendar_month_24" />

                        <TextView
                            android:id="@+id/start_date"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/start_date"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="@dimen/text_size16" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/time_picker_card"
                    android:layout_width="0dp"
                    android:layout_height="43dp"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="@color/gray700"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/baseline_access_time_24" />

                        <TextView
                            android:id="@+id/start_time"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/enter_time_without_star"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="@dimen/text_size16" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="310dp"
                android:layout_height="23dp"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/end_time"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size16"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="310dp"
                android:layout_height="43dp"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:layout_marginTop="5dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/date_picker_card1"
                    android:layout_width="0dp"
                    android:layout_height="43dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="11dp"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="@color/gray700"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/baseline_calendar_month_24" />

                        <TextView
                            android:id="@+id/end_date"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/enter_date_without_star"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="@dimen/text_size16" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/time_picker_card1"
                    android:layout_width="0dp"
                    android:layout_height="43dp"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="@color/gray700"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/baseline_access_time_24" />

                        <TextView
                            android:id="@+id/end_time"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/enter_time_without_star"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="@dimen/text_size16" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <TextView
                android:id="@+id/date_error_text"
                android:layout_width="310dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="4dp"
                android:textColor="@color/error_red"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/time_error_text"
                android:layout_width="310dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="4dp"
                android:textColor="@color/error_red"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/timezonePickerCard"
                android:layout_width="310dp"
                android:layout_height="43dp"
                android:layout_gravity="center"
                android:layout_marginTop="11dp"
                app:cardCornerRadius="8dp"
                app:strokeColor="@color/gray700"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/globe_time_zone" />

                    <TextView
                        android:id="@+id/timezoneText"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:hint="@string/enter_zone"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="@dimen/text_size16"/>

                    <ImageView
                        android:id="@+id/dropdown_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/outline_arrow_drop_down_24"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:padding="7dp"
                android:gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="5dp">

                <TextView
                    android:id="@+id/txt_next2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/next_button"
                    android:textColor="@color/accent1"
                    android:textFontWeight="600"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="20dp"
                    android:textSize="@dimen/text_size16"
                    android:background="@drawable/button_next"
                    app:fontFamily="Poppins"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    </LinearLayout>
    </ScrollView>
</LinearLayout>