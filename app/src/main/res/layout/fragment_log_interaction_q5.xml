<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:paddingTop="?attr/actionBarSize"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/root_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:padding="5dp"
            android:text="@string/visit_log_inside"
            android:textColor="@color/black"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textFontWeight="700"
            app:fontFamily="Poppins" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal">

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_yellow" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_yellow" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_yellow" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_yellow" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_yellow_with_border" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_green_dark" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_green_dark" />
        </LinearLayout>

        <!-- Card Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Question header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tv_question"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Question 5/7"
                        android:textSize="16sp"
                        android:textColor="#424242" />

                    <TextView
                        android:id="@+id/btn_skip"
                        android:layout_width="90dp"
                        android:layout_height="38dp"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/button_skip_outline"
                        android:text="Skip"
                        android:textColor="#0D3B3B"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textAllCaps="false" />
                </RelativeLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#E0E0E0" />

                <!-- Section 1: Number of people helped -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Number of people helped"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:fontFamily="Poppins"
                    android:textColor="@color/black"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="10dp">

                    <FrameLayout
                        android:id="@+id/btn_decrease_helped"
                        android:layout_width="36dp"
                        android:layout_height="36dp">

                        <View
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/circle_button_bg"/>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_minus"
                            android:tint="#F4D03F"
                            android:contentDescription="Decrease count"
                            tools:ignore="UseAppTint" />
                    </FrameLayout>

                    <EditText
                        android:id="@+id/tv_count_helped"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:text="1"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        app:fontFamily="Poppins"
                        android:textColor="#000000"
                        android:inputType="number"
                        android:gravity="center"
                        android:minWidth="48dp"
                        android:selectAllOnFocus="true"
                        android:background="@android:color/transparent" />

                    <FrameLayout
                        android:id="@+id/btn_increase_helped"
                        android:layout_width="36dp"
                        android:layout_height="36dp">

                        <View
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/circle_button_bg"/>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_plus"
                            android:tint="#F4D03F"
                            android:contentDescription="Increase count"
                            tools:ignore="UseAppTint" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Section 2: How many people joined you -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="How many people have joined you?"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:fontFamily="Poppins"
                    android:textColor="@color/black"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="10dp">

                    <FrameLayout
                        android:id="@+id/btn_decrease_joined"
                        android:layout_width="36dp"
                        android:layout_height="36dp">

                        <View
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/circle_button_bg"/>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_minus"
                            android:tint="#F4D03F"
                            android:contentDescription="Decrease count"
                            tools:ignore="UseAppTint" />
                    </FrameLayout>

                    <EditText
                        android:id="@+id/tv_count_joined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:text="0"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        app:fontFamily="Poppins"
                        android:textColor="#000000"
                        android:inputType="number"
                        android:gravity="center"
                        android:minWidth="48dp"
                        android:selectAllOnFocus="true"
                        android:background="@android:color/transparent" />

                    <FrameLayout
                        android:id="@+id/btn_increase_joined"
                        android:layout_width="36dp"
                        android:layout_height="36dp">

                        <View
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/circle_button_bg"/>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_plus"
                            android:tint="#F4D03F"
                            android:contentDescription="Increase count"
                            tools:ignore="UseAppTint" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Navigation buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="24dp">

                    <TextView
                        android:id="@+id/btn_previous"
                        android:layout_width="110dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="Previous"
                        android:textColor="#0D3B3B"
                        android:background="@drawable/button_outline"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btn_next"
                        android:layout_width="120dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="Next"
                        android:textColor="#F4D03F"
                        android:background="@drawable/button_next_filled"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</LinearLayout>

