<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Big question title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/number_of_care_packages_given_out"
        android:textSize="22sp"
        app:fontFamily="@font/poppins_bold_new"
        android:textColor="@color/black"
        android:gravity="center" />

    <!-- Counter row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="14dp">

        <!-- Minus button -->
        <FrameLayout
            android:id="@+id/btn_decrease"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="20dp">

            <View
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_button_bg" />
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_minus"
                android:tint="#F4D03F"
                android:contentDescription="@string/decrease_count_btn_txt"
                tools:ignore="UseAppTint" />
        </FrameLayout>

        <!-- Counter value -->
        <EditText
            android:id="@+id/et_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:padding="12dp"
            android:text="0"
            android:textSize="28sp"
            android:textStyle="bold"
            app:fontFamily="@font/poppins_bold_new"
            android:textColor="#071F1E"
            android:inputType="number"
            android:gravity="center"
            android:minWidth="48dp"
            android:selectAllOnFocus="true"
            android:background="@drawable/textfield_bg" />

        <!-- Plus button -->
        <FrameLayout
            android:id="@+id/btn_increase"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="20dp">

            <View
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_button_bg" />
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_plus"
                android:tint="#F4D03F"
                android:contentDescription="@string/increase_count_btn_txt"
                tools:ignore="UseAppTint" />
        </FrameLayout>
    </LinearLayout>

    <!-- Sub question -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/what_items_were_included_in_the_care_package"
        android:textSize="22sp"
        app:fontFamily="@font/poppins_bold_new"
        android:textColor="@color/black"
        android:gravity="center" />

    <EditText
        android:id="@+id/et_notes"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginTop="12dp"
        android:importantForAutofill="no"
        android:background="@drawable/textfield_bg"
        android:gravity="top|start"
        android:hint="@string/items_in_care_package_examples"
        android:padding="12dp"
        android:textColor="#071F1E"
        android:textSize="14sp"
        android:inputType="textMultiLine"
        android:lines="5"
        android:maxLines="6"
        app:fontFamily="@font/poppins_bold_new" />

</LinearLayout>
