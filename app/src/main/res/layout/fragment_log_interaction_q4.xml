<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="?attr/actionBarSize"
    android:background="@android:color/white">

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:fitsSystemWindows="true"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tvHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="5dp"
                android:text="@string/visit_log_inside"
                android:textColor="@color/black"
                android:textSize="28sp"
                android:includeFontPadding="false"
                app:fontFamily="@font/poppins_bold_new"/>

            <!-- Progress dots -->
            <org.brightmindenrichment.street_care.ui.widget.StepProgressView
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp" />

            <!-- Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/content_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_gravity="center"
                app:cardCornerRadius="10dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@color/gray700"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="14dp">

                    <!-- Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/question_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/question_progress_3"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            app:fontFamily="@font/poppins_regular"/>

                        <TextView
                            android:id="@+id/skip_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_skip"
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:background="@drawable/rounded_btn"
                            android:gravity="center"
                            app:fontFamily="@font/poppins_bold_new"/>
                    </LinearLayout>

                    <!-- Divider -->
                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="0.7dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:dividerColor="@color/gray700"/>

                    <!-- Content -->
                    <LinearLayout
                        android:id="@+id/contentInset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingTop="10dp">

                        <TextView
                            android:id="@+id/support_question"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/what_support_you_provided"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:layout_marginBottom="8dp"
                            app:fontFamily="@font/poppins_bold_new"/>

                        <!-- Checkboxes -->
                        <LinearLayout
                            android:id="@+id/checkbox_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatCheckBox
                                android:id="@+id/food_checkbox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:button="@null"
                                android:drawableStart="@drawable/cb_square_green"
                                android:drawablePadding="9dp"
                                android:minHeight="36dp"
                                android:text="@string/food_drinks"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                app:fontFamily="@font/poppins_regular"/>

                            <androidx.appcompat.widget.AppCompatCheckBox
                                android:id="@+id/clothes_checkbox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:button="@null"
                                android:drawableStart="@drawable/cb_square_green"
                                android:drawablePadding="9dp"
                                android:minHeight="36dp"
                                android:text="@string/clothes"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                app:fontFamily="@font/poppins_regular"/>

                            <androidx.appcompat.widget.AppCompatCheckBox
                                android:id="@+id/hygiene_checkbox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:button="@null"
                                android:drawableStart="@drawable/cb_square_green"
                                android:drawablePadding="9dp"
                                android:minHeight="36dp"
                                android:text="@string/hygiene"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                app:fontFamily="@font/poppins_regular"/>

                            <androidx.appcompat.widget.AppCompatCheckBox
                                android:id="@+id/wellness_checkbox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:button="@null"
                                android:drawableStart="@drawable/cb_square_green"
                                android:drawablePadding="9dp"
                                android:minHeight="36dp"
                                android:text="@string/wellness_emotional_support"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                app:fontFamily="@font/poppins_regular"/>

                            <androidx.appcompat.widget.AppCompatCheckBox
                                android:id="@+id/medical_checkbox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:button="@null"
                                android:drawableStart="@drawable/cb_square_green"
                                android:drawablePadding="9dp"
                                android:minHeight="36dp"
                                android:text="@string/medical_help"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                app:fontFamily="@font/poppins_regular"/>

                            <androidx.appcompat.widget.AppCompatCheckBox
                                android:id="@+id/social_worker_checkbox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:button="@null"
                                android:drawableStart="@drawable/cb_square_green"
                                android:drawablePadding="9dp"
                                android:minHeight="36dp"
                                android:text="@string/social_worker_psychiatrist"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                app:fontFamily="@font/poppins_regular"/>

                            <androidx.appcompat.widget.AppCompatCheckBox
                                android:id="@+id/legal_checkbox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:button="@null"
                                android:drawableStart="@drawable/cb_square_green"
                                android:drawablePadding="9dp"
                                android:minHeight="36dp"
                                android:text="@string/lawyer_legal"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                app:fontFamily="@font/poppins_regular"/>

                            <androidx.appcompat.widget.AppCompatCheckBox
                                android:id="@+id/other_checkbox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:button="@null"
                                android:drawableStart="@drawable/cb_square_green"
                                android:drawablePadding="9dp"
                                android:minHeight="36dp"
                                android:text="@string/other"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                app:fontFamily="@font/poppins_regular"/>

                            <!-- Other Input -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilOther"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:visibility="gone"
                                app:hintEnabled="false"
                                app:boxStrokeWidth="1dp"
                                app:boxStrokeColor="@color/gray700"
                                app:boxCornerRadiusTopStart="10dp"
                                app:boxCornerRadiusTopEnd="10dp"
                                app:boxCornerRadiusBottomStart="10dp"
                                app:boxCornerRadiusBottomEnd="10dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/other_input"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:minHeight="60dp"
                                    android:hint="@string/if_other_please_specify_here"
                                    android:gravity="start"
                                    android:paddingTop="8dp"
                                    android:paddingBottom="10dp"
                                    android:background="@drawable/rounded_border_field"
                                    android:includeFontPadding="false"
                                    android:inputType="textCapSentences"
                                    android:textSize="16sp"/>
                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:id="@+id/btn_previous"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Previous"
                            android:textColor="@color/dark_green"
                            android:paddingVertical="6dp"
                            android:paddingHorizontal="18dp"
                            android:background="@drawable/button_previous"
                            android:textStyle="bold"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>

                        <TextView
                            android:id="@+id/btn_next"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/next_button"
                            android:textColor="@color/accent1"
                            android:textSize="16sp"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="22dp"
                            android:background="@drawable/button_next"
                            android:textStyle="bold"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
