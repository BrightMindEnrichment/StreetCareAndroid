<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="?attr/actionBarSize"
    android:background="@android:color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- Page title — always "Visit Log" for IL -->
            <TextView
                android:id="@+id/tvPageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="5dp"
                android:text="@string/visit_log_inside"
                android:textColor="@color/black"
                android:textSize="28sp"
                android:includeFontPadding="false"
                app:fontFamily="@font/poppins_bold_new" />

            <!-- Progress dots — IL only -->
            <org.brightmindenrichment.street_care.ui.widget.StepProgressView
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp" />

            <!-- Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@color/gray700"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="14dp">

                    <!-- Header row: [step label] [Skip button] -->
                    <LinearLayout
                        android:id="@+id/headerRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/tvStepLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            app:fontFamily="@font/poppins_regular" />

                        <TextView
                            android:id="@+id/btnSkip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/skip"
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:background="@drawable/rounded_btn"
                            android:gravity="center"
                            app:fontFamily="@font/poppins_bold_new" />
                    </LinearLayout>

                    <!-- Divider -->
                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="0.7dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:dividerColor="@color/gray700" />

                    <!-- CONTENT SLOT — subclass injects question content here -->
                    <FrameLayout
                        android:id="@+id/contentContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="0dp" />

                    <!-- Yes/No row — GONE by default, shown for ILq7 -->
                    <LinearLayout
                        android:id="@+id/yesNoRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="6dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/btnYes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/yesbutton"
                            android:paddingHorizontal="20dp"
                            android:paddingVertical="8dp"
                            android:text="@string/yes"
                            android:gravity="center"
                            android:textColor="@color/accent1"
                            android:textFontWeight="600"
                            android:textSize="@dimen/text_size16"
                            app:fontFamily="Poppins" />

                        <View
                            android:layout_width="22dp"
                            android:layout_height="0dp" />

                        <TextView
                            android:id="@+id/btnNo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/nobutton"
                            android:gravity="center"
                            android:paddingHorizontal="20dp"
                            android:paddingVertical="8dp"
                            android:text="@string/no"
                            android:textColor="@color/gray900"
                            android:textFontWeight="900"
                            android:textSize="@dimen/text_size16"
                            app:fontFamily="Poppins" />
                    </LinearLayout>

                    <!-- Standard button row: [Previous] [spacer] [Next] -->
                    <LinearLayout
                        android:id="@+id/buttonRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="24dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:id="@+id/btnPrevious"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Previous"
                            android:textColor="@color/dark_green"
                            android:paddingVertical="6dp"
                            android:paddingHorizontal="18dp"
                            android:background="@drawable/button_previous"
                            android:textStyle="bold" />

                        <View
                            android:id="@+id/buttonSpacer"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/btnNext"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/next_button"
                            android:textColor="@color/accent1"
                            android:textSize="16sp"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="22dp"
                            android:background="@drawable/button_next"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
