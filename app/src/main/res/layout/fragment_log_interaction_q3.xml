<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- Top placeholder/status bar -->
    <View
        android:id="@+id/status_bar_placeholder"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- App bar -->
    <!-- App bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"  android:layout_height="55dp"
        android:background="@android:color/white"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"  app:layout_constraintEnd_toEndOf="parent"      tools:layout_editor_absoluteX="0dp">

        <FrameLayout
            android:id="@+id/btn_close_container"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/red_circle_background"
            android:padding="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/icon_close"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@string/btn_close_description"
                android:src="@drawable/ic_close"
                app:tint="@android:color/white" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/header_interaction_log"
            android:textColor="@android:color/black"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btn_close_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_close_container" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Main scrollable content -->
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="420dp"
        android:layout_height="585dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/status_bar_placeholder"
        app:layout_constraintTop_toBottomOf="@+id/app_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="0dp">

            <TextView
                android:id="@+id/tv_screen_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="5dp"
                android:text="@string/title_log_interaction"
                android:textAlignment="center"
                android:textColor="@android:color/black"
                android:textSize="25sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="40dp"
                    android:layout_height="15dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/progress_dot_yellow" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="15dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/progress_dot_yellow" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="15dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/progress_dot_yellow_with_border" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="15dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/progress_dot_yellow" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="15dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/progress_dot_green_dark" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="15dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/progress_dot_green_dark" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="15dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/progress_dot_green_dark" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/content_card"
                android:layout_width="364dp"
                android:layout_height="512dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="5dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:id="@+id/question_container"
                    android:layout_width="match_parent"
                    android:layout_height="506dp"
                    android:background="@android:color/white"
                    android:orientation="vertical"
                    android:paddingTop="15dp"
                    android:paddingBottom="15dp">

                    <!-- Question label + skip -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="20dp">

                        <TextView
                            android:id="@+id/question_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="10dp"
                            android:layout_toStartOf="@id/skip_btn"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/question_progress_2"
                            android:textColor="#000000"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/skip_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/skip_button_border"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="12dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="4dp"
                            android:text="@string/action_skip"
                            android:textColor="#000000"
                            android:textSize="14sp" />
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="20dp"
                        android:background="#E0E0E0" />

                    <TextView
                        android:id="@+id/support_question"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:paddingHorizontal="20dp"
                        android:text="@string/label_interaction_location_question"
                        android:textAlignment="center"
                        android:textColor="#000000"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/location_input_fields_container"
                        android:layout_width="match_parent"
                        android:layout_height="270dp"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="41dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/search_bar_rounded_background"
                            android:paddingHorizontal="5dp"
                            android:paddingVertical="4dp">

                            <ImageView
                                android:id="@+id/icon_search"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:contentDescription="@string/desc_search_icon"
                                android:src="@drawable/ic_search"
                                app:tint="#616161" />

                            <AutoCompleteTextView
                                android:id="@+id/input_address"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_toStartOf="@+id/icon_mic"
                                android:layout_toEndOf="@id/icon_search"
                                android:background="@android:color/transparent"
                                android:completionThreshold="1"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:hint="Search for address"
                                android:imeOptions="actionSearch"
                                android:inputType="textPostalAddress"
                                android:minHeight="48dp"
                                android:paddingStart="10dp"
                                android:textColor="@android:color/black"
                                android:textSize="16sp" />

                            <ImageView
                                android:id="@+id/icon_mic"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:contentDescription="@string/desc_mic_icon"
                                android:focusable="true"
                                android:padding="8dp"
                                android:src="@drawable/ic_mic"
                                app:tint="#606060" />
                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/input_city"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:autofillHints="personAddressLocality"
                                android:background="@drawable/edittext_rounded"
                                android:hint="@string/hint_city_example"
                                android:inputType="textCapWords"
                                android:minHeight="48dp"
                                android:padding="12dp"
                                android:textAlignment="center"
                                android:textColor="#000000"
                                android:textSize="16sp" />

                            <EditText
                                android:id="@+id/input_state"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:autofillHints="personAddressRegion"
                                android:background="@drawable/edittext_rounded"
                                android:hint="@string/hint_state_example"
                                android:inputType="textCapCharacters"
                                android:maxLength="2"
                                android:minHeight="48dp"
                                android:padding="8dp"
                                android:textAlignment="center"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/input_zip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:autofillHints="postalCode"
                            android:background="@drawable/edittext_rounded"
                            android:hint="@string/hint_zip_example"
                            android:inputType="number"
                            android:maxLength="5"
                            android:minHeight="48dp"
                            android:padding="12dp"
                            android:textAlignment="viewStart"
                            android:textColor="#000000"
                            android:textSize="16sp" />

                        <EditText
                            android:id="@+id/input_description"
                            android:layout_width="match_parent"
                            android:layout_height="73dp"
                            android:autofillHints="none"
                            android:background="@drawable/edittext_rounded"
                            android:gravity="top|start"
                            android:hint="@string/hint_description"
                            android:inputType="textMultiLine"
                            android:minHeight="125dp"
                            android:padding="8dp"
                            android:textColor="#000000"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/navigation_buttons"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_previous"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="120dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="16dp"
                            android:text="@string/action_previous"
                            android:textColor="@android:color/black"
                            app:cornerRadius="24dp"
                            app:strokeColor="@color/gray_outline" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <Button
                            android:id="@+id/btn_next"
                            android:layout_width="105dp"
                            android:layout_height="50dp"
                            android:layout_marginEnd="12dp"
                            android:backgroundTint="@color/dark_greener"
                            android:text="@string/action_next"
                            android:textColor="#f0e192"
                            app:cornerRadius="24dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:itemIconTint="@color/nav_item_yellow_selector"
        app:itemTextColor="@color/black"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/activity_main_drawer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:itemBackground="@drawable/nav_active_indicator"
        app:itemActiveIndicatorStyle="@null" />

</androidx.constraintlayout.widget.ConstraintLayout>





