<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:paddingTop="?attr/actionBarSize"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:padding="5dp"
            android:text="@string/visit_log_inside"
            android:textColor="@color/black"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textFontWeight="700"
            app:fontFamily="Poppins" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal">

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_yellow" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_yellow" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_yellow_with_border" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_green_dark" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_green_dark" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_green_dark" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_green_dark" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/content_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="30dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@color/gray700"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:layout_marginTop="10dp"
                            android:layout_marginStart="12dp"
                            android:text="@string/question_progress_2"
                            android:textColor="@color/black"
                            android:textFontWeight="400"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/skip_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/rounded_btn"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="7dp"
                            android:text="@string/skip"
                            android:textColor="@color/dark_green"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:fontFamily="Poppins" />
                    </FrameLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginStart="19dp"
                        android:layout_marginEnd="19dp"
                        android:background="@color/gray300" />

                    <TextView
                        android:id="@+id/support_question"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="@string/label_interaction_location_question"
                        android:textColor="@color/black"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        app:fontFamily="Poppins" />

                    <LinearLayout
                        android:id="@+id/location_input_fields_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="41dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/search_bar_rounded_background"
                            android:paddingHorizontal="5dp"
                            android:paddingVertical="4dp">

                            <ImageView
                                android:id="@+id/icon_search"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:contentDescription="@string/desc_search_icon"
                                android:src="@drawable/ic_search"
                                app:tint="#616161" />

                            <AutoCompleteTextView
                                android:id="@+id/input_address"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_toStartOf="@+id/icon_mic"
                                android:layout_toEndOf="@id/icon_search"
                                android:background="@android:color/transparent"
                                android:completionThreshold="1"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:hint="@string/search_for_address"
                                android:imeOptions="actionSearch"
                                android:inputType="textPostalAddress"
                                android:minHeight="48dp"
                                android:textColor="@android:color/black"
                                android:textSize="16sp" />

                            <ImageView
                                android:id="@+id/icon_mic"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:contentDescription="@string/desc_mic_icon"
                                android:focusable="true"
                                android:padding="8dp"
                                android:src="@drawable/mic_24"
                                app:tint="#606060" />
                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/input_city"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:autofillHints="personAddressLocality"
                                android:background="@drawable/edittext_rounded"
                                android:hint="@string/hint_city_example"
                                android:inputType="textCapWords"
                                android:minHeight="48dp"
                                android:padding="12dp"
                                android:textAlignment="center"
                                android:textColor="#000000"
                                android:textSize="16sp" />

                            <EditText
                                android:id="@+id/input_state"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:autofillHints="personAddressRegion"
                                android:background="@drawable/edittext_rounded"
                                android:hint="@string/hint_state_example"
                                android:inputType="textCapCharacters"
                                android:minHeight="48dp"
                                android:padding="8dp"
                                android:textAlignment="center"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/input_zip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:autofillHints="postalCode"
                            android:background="@drawable/edittext_rounded"
                            android:hint="@string/hint_zip_example"
                            android:inputType="number"
                            android:maxLength="5"
                            android:minHeight="48dp"
                            android:padding="12dp"
                            android:textAlignment="viewStart"
                            android:textColor="#000000"
                            android:textSize="16sp" />

                        <EditText
                            android:id="@+id/input_description"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:importantForAutofill="no"
                            android:background="@drawable/edittext_rounded"
                            android:gravity="top|start"
                            android:hint="@string/hint_description"
                            android:inputType="textMultiLine"
                            android:padding="8dp"
                            android:textColor="#000000"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="8dp" />

                    <LinearLayout
                        android:id="@+id/navigation_buttons"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="7dp"
                        android:layout_marginBottom="5dp">

                        <TextView
                            android:id="@+id/btn_previous"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Previous"
                            android:textColor="@color/dark_green"
                            android:layout_gravity="center_vertical"
                            android:textFontWeight="500"
                            android:textSize="@dimen/text_size12"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="20dp"
                            android:background="@drawable/button_previous"
                            app:fontFamily="Poppins" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/btn_next"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/next_button"
                            android:textColor="@color/accent1"
                            android:textFontWeight="600"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="20dp"
                            android:textSize="@dimen/text_size16"
                            android:background="@drawable/button_next"
                            app:fontFamily="Poppins" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
