<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="?attr/actionBarSize"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/root_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:padding="5dp"
            android:text="@string/visit_log_inside"
            android:textColor="@color/black"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textFontWeight="700"
            app:fontFamily="Poppins" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal">

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_yellow" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_yellow" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_yellow" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_yellow" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_yellow" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_yellow_with_border" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_green_dark" />
        </LinearLayout>

        <!-- Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            app:cardUseCompatPadding="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Header row: question count and Skip -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tv_question"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/interaction_log_question_6_7"
                        android:textSize="16sp"
                        android:textColor="#424242" />

                    <TextView
                        android:id="@+id/btn_skip"
                        android:layout_width="78dp"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/button_skip_outline"
                        android:text="@string/skip_btn_txt"
                        android:textColor="#0D3B3B"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textAllCaps="false" />
                </RelativeLayout>

                <!-- thin divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#E6E6E6" />

                <!-- Big question title -->
                <TextView
                    android:id="@+id/tv_big_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/number_of_care_packages_given_out"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:fontFamily="Poppins"
                    android:textColor="@color/black"
                    android:gravity="center" />

                <!-- counter row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="14dp">

                    <!-- Minus button (smaller) -->
                    <FrameLayout
                        android:id="@+id/btn_decrease"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="20dp">

                        <View
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/circle_button_bg"/>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_minus"
                            android:tint="#F4D03F"
                            android:contentDescription="@string/decrease_count_btn_txt"
                            tools:ignore="UseAppTint" />
                    </FrameLayout>

                    <!-- Counter value -->
                    <TextView
                        android:id="@+id/tv_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        app:fontFamily="Poppins"
                        android:textColor="#071F1E"
                        android:gravity="center" />

                    <!-- Plus button (smaller) -->
                    <FrameLayout
                        android:id="@+id/btn_increase"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="20dp">

                        <View
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/circle_button_bg"/>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_plus"
                            android:tint="#F4D03F"
                            android:contentDescription="@string/increase_count_btn_txt"
                            tools:ignore="UseAppTint" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Sub question -->
                <TextView
                    android:id="@+id/tv_sub_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/what_items_were_included_in_the_care_package"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:fontFamily="Poppins"
                    android:textColor="@color/black"
                    android:gravity="center" />

                <EditText
                    android:id="@+id/et_notes"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="12dp"
                    android:importantForAutofill="no"
                    android:background="@drawable/textfield_bg"
                    android:gravity="top|start"
                    android:hint="@string/items_in_care_package_examples"
                    android:padding="12dp"
                    android:textColor="#071F1E"
                    android:textSize="14sp"
                    android:inputType="textMultiLine"
                    android:lines="5"
                    android:maxLines="6" />

                <!-- Buttons row -->
                <LinearLayout
                    android:id="@+id/nav_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="22dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/btn_previous"
                        android:layout_width="120dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="@string/previous_btn_txt"
                        android:textColor="#0D3B3B"
                        android:background="@drawable/button_outline"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btn_next"
                        android:layout_width="120dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="@string/next_btn_txt"
                        android:textColor="#F4D03F"
                        android:background="@drawable/button_next_filled"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- spacing bottom so scroll content looks centered on tall screens -->
        <View
            android:layout_width="match_parent"
            android:layout_height="18dp"/>
    </LinearLayout>
</LinearLayout>
