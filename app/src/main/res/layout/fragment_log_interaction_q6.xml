<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="?attr/actionBarSize"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/root_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:padding="5dp"
            android:text="@string/visit_log_inside"
            android:textColor="@color/black"
            android:textSize="28sp"
            android:includeFontPadding="false"
            app:fontFamily="@font/poppins_bold_new" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal">

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_yellow" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_yellow" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_yellow" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_yellow" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_yellow" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_yellow_with_border" />

            <View
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/progress_dot_green_dark" />
        </LinearLayout>

        <!-- Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true"
            app:strokeColor="@color/gray700"
            app:strokeWidth="1.2dp"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Header row: question count and Skip -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tv_question"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/interaction_log_question_6_7"
                        android:textSize="14sp"
                        android:textColor="#424242"
                        app:fontFamily="@font/poppins_regular" />

                    <TextView
                        android:id="@+id/btn_skip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/rounded_btn"
                        android:text="@string/skip_btn_txt"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:textAllCaps="false"
                        app:fontFamily="@font/poppins_bold_new" />
                </RelativeLayout>

                <!-- thin divider -->
                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="0.7dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:dividerColor="@color/gray700"/>

                <!-- Big question title -->
                <TextView
                    android:id="@+id/tv_big_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/number_of_care_packages_given_out"
                    android:textSize="22sp"
                    app:fontFamily="@font/poppins_bold_new"
                    android:textColor="@color/black"
                    android:gravity="center" />

                <!-- counter row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="14dp">

                    <!-- Minus button (smaller) -->
                    <FrameLayout
                        android:id="@+id/btn_decrease"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="20dp">

                        <View
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/circle_button_bg"/>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_minus"
                            android:tint="#F4D03F"
                            android:contentDescription="@string/decrease_count_btn_txt"
                            tools:ignore="UseAppTint" />
                    </FrameLayout>

                    <!-- Counter value -->
                    <TextView
                        android:id="@+id/tv_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        app:fontFamily="Poppins"
                        android:textColor="#071F1E"
                        android:gravity="center" />

                    <!-- Plus button (smaller) -->
                    <FrameLayout
                        android:id="@+id/btn_increase"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="20dp">

                        <View
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/circle_button_bg"/>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_plus"
                            android:tint="#F4D03F"
                            android:contentDescription="@string/increase_count_btn_txt"
                            tools:ignore="UseAppTint" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Sub question -->
                <TextView
                    android:id="@+id/tv_sub_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/what_items_were_included_in_the_care_package"
                    android:textSize="22sp"
                    app:fontFamily="@font/poppins_bold_new"
                    android:textColor="@color/black"
                    android:gravity="center" />

                <EditText
                    android:id="@+id/et_notes"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="12dp"
                    android:importantForAutofill="no"
                    android:background="@drawable/textfield_bg"
                    android:gravity="top|start"
                    android:hint="@string/items_in_care_package_examples"
                    android:padding="12dp"
                    android:textColor="#071F1E"
                    android:textSize="14sp"
                    android:inputType="textMultiLine"
                    android:lines="5"
                    android:maxLines="6" />

                <!-- Buttons row -->
                <LinearLayout
                    android:id="@+id/nav_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="22dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/btn_previous"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/previous_btn_txt"
                        android:textColor="@color/dark_green"
                        android:background="@drawable/button_previous"
                        android:textStyle="bold"
                        android:paddingVertical="6dp"
                        android:paddingHorizontal="18dp"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btn_next"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/next_btn_txt"
                        android:textColor="@color/accent1"
                        android:background="@drawable/button_next"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="22dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- spacing bottom so scroll content looks centered on tall screens -->
        <View
            android:layout_width="match_parent"
            android:layout_height="18dp"/>
    </LinearLayout>
</ScrollView>
