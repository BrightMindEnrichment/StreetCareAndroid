<?xml version="1.0" encoding="utf-8"?><!--    Root LinearLayout-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!--    Big centered screen title-->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:gravity="center"
        android:padding="2dp"
        android:text="@string/visit_log_inside"
        android:textColor="@color/black"
        android:textFontWeight="700"
        android:textSize="30sp"
        app:fontFamily="@font/poppins_bold"
        android:textStyle="bold" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_visitlog2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="35dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true"
        app:strokeColor="@color/gray700"
        app:strokeWidth="1.2dp">

        <!-- Inner vertical layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="34dp"
            android:paddingBottom="34dp">

            <!-- Checkbox + consent text in one row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <CheckBox
                    android:id="@+id/cbConsent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/black"
                    android:gravity="top"
                    android:theme="@style/CheckboxYellowTickTheme"
                    android:textAlignment="center"
                    android:text="@string/consent_text"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="12dp"
                    android:autoSizeMaxTextSize="16dp"
                    android:autoSizeStepGranularity="2dp"
                    />
s


<!--                <TextView-->
<!--                    android:layout_width="0dp"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_weight="1"-->
<!--                    android:includeFontPadding="false"-->
<!--                    android:text="@string/consent_text"-->
<!--                    android:textAlignment="center"-->
<!--                    android:paddingStart="8dp"-->
<!--                    app:layout_constraintTop_toTopOf="@id/cbConsent"-->
<!--                    app:layout_constraintStart_toEndOf="@id/cbConsent"-->
<!--                    app:layout_constraintEnd_toEndOf="parent"-->
<!--                    app:layout_constraintBottom_toBottomOf="@id/cbConsent"-->
<!--                    app:layout_constraintVertical_bias="0.0"-->
<!--                    android:textColor="@android:color/black"-->
<!--                    android:textSize="16sp" />-->


            </LinearLayout>


            <!-- Submit button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitConsent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:backgroundTint="#073532"
                android:elevation="4dp"
                android:enabled="false"
                android:text="@string/submit"
                android:textAllCaps="true"
                android:textColor="@color/golden_yellow"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="40dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
