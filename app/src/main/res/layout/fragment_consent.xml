<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F9F9F9"
    android:clipToPadding="false"
    android:paddingBottom="72dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/visit_log_inside"
            android:textStyle="bold"
            android:textSize="24sp"
            android:textColor="@android:color/black"
            android:layout_marginBottom="0mm"
            android:gravity="center" />

        <!-- Card with shadow -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/consentCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="12dp"
            app:cardUseCompatPadding="true"
            app:strokeColor="@android:color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="5dp"
                android:paddingBottom="30dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:paddingRight="5dp">
                    <CheckBox
                        android:id="@+id/cbConsent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:buttonTint="@color/black"
                        android:theme="@style/CheckboxYellowTickTheme"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
<!--                    <com.google.android.material.checkbox.MaterialCheckBox-->
<!--                        android:id="@+id/cbConsent"-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:text="@string/consent_text"-->
<!--                        android:layout_marginEnd="10dp"-->
<!--                        android:gravity="start|center_vertical"-->
<!--                        app:useMaterialThemeColors="false"-->
<!--                        app:buttonTint="@drawable/checkbox_tint" />-->


                    <TextView
                        android:id="@+id/tvConsentText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/consent_text"
                        android:textColor="@android:color/black"
                        android:textSize="15sp"
                        android:lineSpacingExtra="2dp"
                        android:includeFontPadding="false"
                        android:gravity="start"
                        android:textAlignment="center"
                        app:layout_constraintStart_toEndOf="@id/cbConsent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Submit button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitConsent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/black"
                    android:elevation="10dp"
                    android:translationZ="5dp"
                    android:enabled="false"
                    android:gravity="center"
                    android:paddingStart="30dp"
                    android:paddingEnd="30dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/submit"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:textColor="@color/golden_yellow"
                    android:textSize="16sp"
                    app:cornerRadius="40dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>